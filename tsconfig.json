{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@inno-optimize/agentdb": ["packages/agentdb/src"],
      "@inno-optimize/mcp-framework": ["packages/mcp-framework/src"],
      "@inno-optimize/adr-automation": ["packages/adr-automation/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}